<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.thomasdarimont.keycloak</groupId>
    <artifactId>keycloak-mcp-server</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <!-- what extensions compile against: the SPI, tool catalog types and the admin client facade -->
        <module>modules/api</module>
        <!-- optional database storage: systems, key material and audit events in PostgreSQL -->
        <module>modules/storage</module>
        <!-- the management UI: a Lit single-page app built with npm, packaged as static resources -->
        <module>modules/frontend</module>
        <!-- the Quarkus application -->
        <module>modules/backend</module>
        <!-- test_* tools and prompts for the MCP conformance suite, an extension jar; see conformance/README.md -->
        <module>conformance/fixtures</module>
        <!-- examples/extensions -->
        <module>examples/extensions</module>
    </modules>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <resources-plugin.version>3.3.1</resources-plugin.version>
        <jar-plugin.version>3.4.2</jar-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.40.1.1</quarkus.platform.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <spotless-maven-plugin.version>3.10.4</spotless-maven-plugin.version>
        <!-- pinned above the Quarkus platform's 2.21.7 for the jackson-databind CVE fix; drop once the platform catches up -->
        <jackson.version>2.21.8</jackson.version>
        <auto-service.version>1.1.1</auto-service.version>
        <jandex-maven-plugin.version>3.4.0</jandex-maven-plugin.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <!-- Node the frontend module is built with (downloaded once into modules/frontend/node, git-ignored) -->
        <frontend.node.version>v22.12.0</frontend.node.version>
        <!-- -Dui.skip=true builds the frontend jar without running npm (no UI files inside) -->
        <ui.skip>false</ui.skip>
        <!-- database kind of the storage module, baked into the backend at build time: h2 or postgresql (-Ppostgresql) -->
        <storage.db-kind>h2</storage.db-kind>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <!-- imported first so its versions win over the platform BOM for every Jackson module -->
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.github.thomasdarimont.keycloak</groupId>
                <artifactId>keycloak-mcp-server-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.thomasdarimont.keycloak</groupId>
                <artifactId>keycloak-mcp-server-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.thomasdarimont.keycloak</groupId>
                <artifactId>keycloak-mcp-server-frontend</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service-annotations</artifactId>
                <version>${auto-service.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <configuration>
                        <!-- `quarkus:dev -pl modules/backend -am` also visits the api module, which is a plain library -->
                        <warnIfBuildGoalMissing>false</warnIfBuildGoalMissing>
                        <!-- dev mode runs from the repository root, like the packaged server started there, so the
                             relative paths of the examples' env files (.certs/, data/, examples/run-modes/keys/)
                             resolve the same way in both -->
                        <workingDir>${maven.multiModuleProjectDirectory}</workingDir>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.smallrye</groupId>
                    <artifactId>jandex-maven-plugin</artifactId>
                    <version>${jandex-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <!-- @AutoService generates the META-INF/services entries of the SPI implementations -->
                            <path>
                                <groupId>com.google.auto.service</groupId>
                                <artifactId>auto-service</artifactId>
                                <version>${auto-service.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <argLine>@{argLine}</argLine>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                    <configuration>
                        <java>
                            <importOrder>
                                <order>java|javax|jakarta,org,com,,\#</order>
                            </importOrder>
                            <removeUnusedImports/>
                            <eclipse>
                                <!-- the Spring Java Format conventions with spaces, see the file -->
                                <file>${maven.multiModuleProjectDirectory}/etc/eclipse-formatter.prefs</file>
                            </eclipse>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
                    <executions>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- The database kind of the storage module is fixed when the application is built (Quarkus bakes the
                 dialect in): the default build is for the embedded H2, `./mvnw package -Ppostgresql` builds the
                 server for PostgreSQL. Tests keep running on H2 either way. -->
            <id>postgresql</id>
            <properties>
                <storage.db-kind>postgresql</storage.db-kind>
            </properties>
        </profile>
    </profiles>
</project>
