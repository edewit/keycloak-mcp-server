<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema version 0.3.0: the browser sessions of the management UI. -->
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                                       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="6-user-sessions" author="keycloak-mcp-server">
        <comment>Server-side sessions of the management UI: the tokens of a logged-in browser, keyed by the opaque id
            the session cookie carries; rows past expires_at are purged hourly</comment>
        <createTable tableName="kc_mcp_user_session">
            <column name="id" type="varchar(64)">
                <constraints primaryKey="true" primaryKeyName="pk_kc_mcp_user_session" nullable="false"/>
            </column>
            <!-- alias of the identity provider (kc-mcp.ui.idps.<alias>), its issuer URL, the user's sub and the
                 provider's session id there: issuer + sid (or sub) is what a back-channel logout names -->
            <column name="idp" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="issuer" type="varchar(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="subject" type="varchar(255)"/>
            <column name="sid" type="varchar(255)"/>
            <!-- tokens are encrypted when kc-mcp.storage.secret-key is set -->
            <column name="id_token" type="clob">
                <constraints nullable="false"/>
            </column>
            <column name="access_token" type="clob"/>
            <column name="refresh_token" type="clob"/>
            <column name="access_token_expires_in" type="bigint"/>
            <column name="scope" type="varchar(1024)"/>
            <column name="created_at" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="kc_mcp_user_session" indexName="ix_kc_mcp_user_session_expires">
            <column name="expires_at"/>
        </createIndex>
        <createIndex tableName="kc_mcp_user_session" indexName="ix_kc_mcp_user_session_subject">
            <column name="issuer"/>
            <column name="subject"/>
        </createIndex>
        <createIndex tableName="kc_mcp_user_session" indexName="ix_kc_mcp_user_session_sid">
            <column name="issuer"/>
            <column name="sid"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
