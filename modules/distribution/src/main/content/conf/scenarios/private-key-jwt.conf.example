# Signed JWT instead of a client secret: the client authenticates with a key pair this server holds; Keycloak fetches
# the public key from the server's JWKS. Keycloak: client -> Credentials -> "Signed JWT", "Use JWKS URL" on,
# JWKS URL = http://<this server>:8081/.well-known/jwks.json. The key: openssl genpkey -algorithm RSA
# -pkeyopt rsa_keygen_bits:2048 -out conf/mcp-admin.pem
#   cp conf/scenarios/private-key-jwt.conf.example conf/private-key-jwt.conf   # then edit, and
#   bin/kcmcp.sh start --config conf/private-key-jwt.conf
kc-mcp.systems.default.url=http://localhost:8080
kc-mcp.systems.default.auth-realm=demo
kc-mcp.systems.default.grant-type=client_credentials
kc-mcp.systems.default.client-auth=private_key_jwt
kc-mcp.systems.default.client-id=mcp-jwt
kc-mcp.jwt.key-file=${kcmcp.home.dir}/conf/mcp-admin.pem
kc-mcp.jwt.algorithm=RS256
kc-mcp.systems.default.default-realm=demo
kc-mcp.systems.default.allowed-realms=demo
kc-mcp.tool-exposure=hybrid
