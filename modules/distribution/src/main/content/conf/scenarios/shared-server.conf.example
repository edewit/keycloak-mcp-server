# A shared server for a team or an environment: users log in (as in user-login.conf.example) and the shared profile applies
# the defaults of a server other people reach: anonymous requests get the OAuth challenge, destructive tools are
# confirmed through elicitation only (confirm: true is not accepted), destructive tools must name the realm, the
# Keycloak hosts are listed. Missing settings stop the start with the full list; see docs/security.md.
# Several instances behind a load balancer share their state through the database storage (docs/storage.md).
#   cp conf/scenarios/shared-server.conf.example conf/shared-server.conf   # then edit, and
#   bin/kcmcp.sh start --config conf/shared-server.conf
kc-mcp.profile=shared
kc-mcp.systems.default.url=https://sso.example.com
kc-mcp.systems.default.auth-realm=demo
kc-mcp.allowed-hosts=sso.example.com
kc-mcp.delegation=forward
kc-mcp.systems.default.default-realm=demo
kc-mcp.systems.default.allowed-realms=demo
kc-mcp.tool-exposure=hybrid
quarkus.oidc.tenant-enabled=true
quarkus.oidc.token.audience=mcp-admin
kc-mcp.model-confirmation-trusted-roles=realm-management.realm-admin
# Listen on all interfaces (behind a TLS terminating proxy: also quarkus.http.proxy.proxy-address-forwarding=true).
quarkus.http.host=0.0.0.0
# Database storage, required for several instances; the key encrypts stored keys, secrets and session tokens.
#quarkus.datasource.jdbc.url=jdbc:postgresql://db:5432/kcmcp
#quarkus.datasource.username=kcmcp
#quarkus.datasource.password=change-me
#kc-mcp.storage.secret-key=base64-of-32-random-bytes
