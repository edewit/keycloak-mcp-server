{
  "realm": "demo",
  "displayName": "Demo",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "accessTokenLifespan": 1800,
  "clients": [
    {
      "clientId": "mcp-consumer",
      "name": "MCP consumer (LM Studio, Claude, ...)",
      "description": "Public PKCE client the MCP clients log the user in with; tokens carry aud=keycloak-mcp-server. Full scope off: the role scope lists what a token may carry. Direct access grants only for mcp-call.py.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:33389/mcp-oauth-callback",
        "http://localhost/callback",
        "http://localhost/oauth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email",
        "kc-admin-api"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "1800"
      },
      "protocolMappers": [
        {
          "name": "mcp server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "keycloak-mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "keycloak-mcp-server",
      "name": "Keycloak MCP server",
      "description": "The MCP server's own identity: a service account authenticating with a signed JWT (private_key_jwt); Keycloak fetches the public key from the server's JWKS.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-jwt",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email",
        "kc-admin-api",
        "service_account"
      ],
      "attributes": {
        "use.jwks.url": "true",
        "jwks.url": "http://host.docker.internal:9080/.well-known/jwks.json",
        "token.endpoint.auth.signing.alg": "RS256"
      }
    }
  ],
  "groups": [
    {
      "name": "mcp-admins",
      "path": "/mcp-admins",
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    },
    {
      "name": "mcp-support",
      "path": "/mcp-support",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "name": "staff",
      "path": "/staff"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Liddell",
      "email": "alice@example.com",
      "groups": [
        "/mcp-admins",
        "/staff"
      ],
      "credentials": [
