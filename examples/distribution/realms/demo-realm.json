      ],
      "credentials": [
        {
          "type": "password",
          "value": "carol-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "email": "bob@example.com",
      "groups": [
        "/staff"
      ],
      "credentials": [
        {
          "type": "password",
