# Cross-App Access: the MCP client gets its access token without any login page of its own. The enterprise IdP
# issues an ID-JAG for the user, Keycloak (realm acme, the MCP authorization server) redeems it with the JWT
# authorization grant, and every Admin API call runs with that user's token (forward). The server holds no admin
# credentials; Keycloak enforces the user's realm-management roles, the IdP's policy decides who connects at all:
#   alice  IdP: keycloak-operators  Keycloak: /keycloak-admins  -> realm-admin
#   carol  IdP: keycloak-operators  Keycloak: /keycloak-support -> view-users, view-events
#   bob    IdP: sales               Keycloak: /keycloak-admins  -> the IdP refuses the ID-JAG
#   dave   IdP: keycloak-operators  Keycloak: no account        -> Keycloak refuses the ID-JAG (User not found)
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8101
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=acme
KC_MCP_DELEGATION=forward
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=acme
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=acme
KC_MCP_TOOL_EXPOSURE=hybrid
QUARKUS_HTTP_PORT=8103
# Bearer tokens of realm acme are verified; issuer = KC_MCP_SYSTEMS_DEFAULT_URL/realms/KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM.
QUARKUS_OIDC_TENANT_ENABLED=true
# Only tokens for this server, named by its resource identifier (the "resource" of the protected resource metadata).
# Keycloak ignores the ID-JAG's resource claim, so the audience mapper on the client agent adds it;
# Enterprise-Managed Authorization wants the token audience-restricted to the MCP server.
QUARKUS_OIDC_TOKEN_AUDIENCE=http://localhost:8103
