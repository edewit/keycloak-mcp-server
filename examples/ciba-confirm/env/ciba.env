# CIBA confirmation: the MCP endpoint requires an OAuth login (forward delegation, the user's own token reaches the
# Admin API), and every destructive tool waits for the caller's approval on their device: the server files a CIBA
# authentication request as the client mcp-ciba for the signed-in user, Keycloak delivers it to the approver
# (http://localhost:8095/), the tool runs once the user approves there. confirm: true counts for nothing
# (confirm-fallback=deny), elicitation is not used either (when=always).
#   alice  realm-admin  (alice-demo)     carol  view-users (carol-demo)     dave  nobody (dave-demo)
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8098
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=forward
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
KC_MCP_CONFIRM_FALLBACK=deny
QUARKUS_HTTP_PORT=8099
QUARKUS_OIDC_TENANT_ENABLED=true
QUARKUS_OIDC_TOKEN_AUDIENCE=mcp-admin
# What the protected resource metadata tells MCP clients to ask for. Set explicitly: a shell that still has
# examples/delegated-auth/env/*.env sourced would otherwise advertise the delegation scope, which this realm lacks
# ("Invalid scopes: delegation:client:keycloak-mcp openid" in the Keycloak log).
QUARKUS_OIDC_RESOURCE_METADATA_SCOPES=openid
# the CIBA client (kc-mcp.spi.confirmer.ciba-confirmer.*); issuer defaults to the caller's token issuer, the demo realm
KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_ENABLED=true
KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_CLIENT_ID=mcp-ciba
KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_CLIENT_SECRET=mcp-ciba-secret
KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_TIMEOUT_SECONDS=90
# the second call waits this long for the device, so the model can call again right away and notice the decision
# without the user writing "done" in the chat; a pending answer after that means one more call
KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_POLL_WAIT_SECONDS=25
# KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_FLOW=blocking               # wait in the call instead of answering twice (no number matching)
# KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_WHEN=without-elicitation   # let clients with elicitation ask the human themselves
# KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_LOGIN_HINT=email           # how the provider identifies the user (default: username)
# KC_MCP_SPI_CONFIRMER_CIBA_CONFIRMER_CLIENT_AUTH=client_secret_post   # for providers without HTTP Basic client auth
