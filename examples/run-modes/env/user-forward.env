# User forward: the MCP endpoint requires an OAuth login (LM Studio / Claude open the browser, the user logs in at
# Keycloak as alice or carol) and every Admin API call is made with that user's own access token. The server holds
# no admin credentials at all; Keycloak enforces the user's realm-management roles:
#   alice  /mcp-admins  -> realm-admin                 (everything works)
#   carol  /mcp-support -> view-users, view-events     (reads work, writes come back as forbidden)
#   bob    no realm-management roles                   (every tool call is forbidden)
# LM Studio: copy mcp-oauth.json (pre-registered public client mcp-consumer, PKCE). Keycloak must be up before
# the server starts: the OIDC tenant reads the realm's discovery document at startup.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8080
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=forward
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
# Bearer tokens of realm demo are verified; issuer = KC_MCP_SYSTEMS_DEFAULT_URL/realms/KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM.
QUARKUS_OIDC_TENANT_ENABLED=true
# Only tokens issued for the MCP server: the client scope keycloak-mcp (default on mcp-consumer) adds aud=mcp-admin.
QUARKUS_OIDC_TOKEN_AUDIENCE=mcp-admin
# Realm admins know what they do: the model is told to pass confirm: true right away instead of asking them first
# (guidance only; without elicitation or CIBA the flag is still what confirms, see kc-mcp.model-confirmation).
KC_MCP_MODEL_CONFIRMATION_TRUSTED_ROLES=realm-management.realm-admin
# When the server runs in Docker and reaches Keycloak as http://keycloak:8080, the token issuer still is the
# public URL, and MCP clients must be sent there for the login: uncomment and keep KC_MCP_SYSTEMS_DEFAULT_URL internal.
# QUARKUS_OIDC_TOKEN_ISSUER=http://localhost:8080/realms/demo
# QUARKUS_OIDC_RESOURCE_METADATA_AUTHORIZATION_SERVER=http://localhost:8080/realms/demo
# Optional: a service account next to the forwarded tokens (needed only by the policies provider's lookups).
# KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=mcp-admin
# KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=mcp-admin-secret
