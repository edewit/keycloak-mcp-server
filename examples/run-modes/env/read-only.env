# Read-only auditor: service account mcp-readonly with view-* roles, plus the server-side read-only switch.
KC_MCP_URL=http://localhost:8080
KC_MCP_GRANT_TYPE=client_credentials
KC_MCP_AUTH_REALM=demo
KC_MCP_CLIENT_ID=mcp-readonly
KC_MCP_CLIENT_SECRET=mcp-readonly-secret
KC_MCP_DEFAULT_REALM=demo
KC_MCP_ALLOWED_REALMS=demo
KC_MCP_READ_ONLY=true
KC_MCP_TOOL_EXPOSURE=lazy
