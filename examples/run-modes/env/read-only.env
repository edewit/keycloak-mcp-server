# Read-only auditor: service account mcp-readonly with view-* roles, plus the server-side read-only switch.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8080
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=mcp-readonly
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=mcp-readonly-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_READ_ONLY=true
KC_MCP_TOOL_EXPOSURE=lazy
