# Two "systems" that both point at the demo Keycloak (stand-in for prod/staging): tools get a system argument.
KC_MCP_SYSTEM_DEFAULTS_GRANT_TYPE=client_credentials
KC_MCP_SYSTEM_DEFAULTS_AUTH_REALM=demo
KC_MCP_SYSTEM_DEFAULTS_CLIENT_ID=mcp-admin
KC_MCP_SYSTEM_DEFAULTS_CLIENT_SECRET=mcp-admin-secret
KC_MCP_SYSTEM_DEFAULTS_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_PROD_URL=http://localhost:8080
KC_MCP_SYSTEMS_STAGING_URL=http://localhost:8080
KC_MCP_SYSTEMS_STAGING_ALLOWED_REALMS=demo
KC_MCP_DEFAULT_SYSTEM=prod
