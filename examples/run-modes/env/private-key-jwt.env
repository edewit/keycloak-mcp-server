# private_key_jwt: client mcp-jwt authenticates with a JWT signed by keys/mcp-jwt.pem (run ./gen-key.sh once).
# The Keycloak client is configured with JWKS URL http://host.docker.internal:8081/.well-known/jwks.json, which the
# MCP server serves in this mode, so Keycloak fetches the public key itself. Paths are relative to the repo root.
KC_MCP_URL=http://localhost:8080
KC_MCP_GRANT_TYPE=client_credentials
KC_MCP_CLIENT_AUTH=private_key_jwt
KC_MCP_AUTH_REALM=demo
KC_MCP_CLIENT_ID=mcp-jwt
KC_MCP_JWT_KEY_FILE=examples/run-modes/keys/mcp-jwt.pem
KC_MCP_JWT_ALGORITHM=RS256
KC_MCP_DEFAULT_REALM=demo
KC_MCP_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
