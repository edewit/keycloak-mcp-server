# Shared profile: user-forward (OAuth login, the user's own token reaches the Admin API) plus KC_MCP_PROFILE=shared,
# the defaults of a server other people reach over the network:
#   - anonymous requests get the 401 challenge (require-caller is implied), tokens must carry aud=mcp-admin
#   - destructive tools are confirmed through elicitation only (confirm-fallback=deny): "delete dave" from a client
#     without elicitation answers confirmation_required and confirm: true is not accepted
#   - destructive tools must name the realm although a default realm is set (explicit-target=destructive)
#   - the Keycloak hosts the server talks to are listed (KC_MCP_ALLOWED_HOSTS); unset it to see the start refused
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
KC_MCP_PROFILE=shared
KC_MCP_URL=http://localhost:8080
KC_MCP_AUTH_REALM=demo
KC_MCP_DELEGATION=forward
KC_MCP_DEFAULT_REALM=demo
KC_MCP_ALLOWED_REALMS=demo
KC_MCP_ALLOWED_HOSTS=localhost:8080
KC_MCP_TOOL_EXPOSURE=hybrid
QUARKUS_OIDC_TENANT_ENABLED=true
QUARKUS_OIDC_TOKEN_AUDIENCE=mcp-admin
# When the server runs in Docker and reaches Keycloak as http://keycloak:8080, the token issuer still is the
# public URL: uncomment and keep KC_MCP_URL internal (and list keycloak:8080 in KC_MCP_ALLOWED_HOSTS).
# QUARKUS_OIDC_TOKEN_ISSUER=http://localhost:8080/realms/demo
