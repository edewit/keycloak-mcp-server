# The MCP endpoint requires an OAuth login, the user's own token reaches the Admin API (forward delegation).
#   alice  realm-admin (alice-demo)     carol  view-users (carol-demo)     dave  nobody (dave-demo)
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
KC_MCP_SYSTEMS_DEFAULT_URL=https://localhost:8100
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=forward
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
QUARKUS_HTTP_PORT=8101
QUARKUS_OIDC_TENANT_ENABLED=true
# Added by the client scope mcp-server (setup.sh).
QUARKUS_OIDC_TOKEN_AUDIENCE=keycloak-mcp-server
# What MCP clients are told to ask for: the Admin API audience, this server's audience, the user's admin roles (setup.sh).
QUARKUS_OIDC_RESOURCE_METADATA_SCOPES=kc-admin-api,mcp-server,mcp-admin-roles
