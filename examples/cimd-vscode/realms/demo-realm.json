  "clientProfiles": {
    "profiles": [
      {
        "name": "mcp-cimd",
        "description": "MCP clients identified by a client ID metadata document",
        "executors": [
          {
            "executor": "client-id-metadata-document",
            "configuration": {
              "cimd-allow-permitted-domains": [
                "vscode.dev",
                "code.visualstudio.com",
                "127.0.0.1"
              ],
              "cimd-restrict-same-domain": false,
              "cimd-required-properties": [
                "client_id",
                "client_name",
                "redirect_uris"
              ]
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "mcp-cimd",
        "description": "Client IDs that are https URLs on vscode.dev",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-id-uri",
            "configuration": {
              "client-id-uri-scheme": [
                "https"
              ],
              "client-id-uri-allow-permitted-domains": [
                "vscode.dev"
              ]
            }
          }
        ],
        "profiles": [
          "mcp-cimd"
        ]
      }
    ]
  }
