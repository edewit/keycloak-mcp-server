# Management UI on the run-modes demo stack (Keycloak :8080, realm demo): the server acts as realm admin through
# mcp-admin, the UI signs people in at the demo realm with the public PKCE client keycloak-mcp-ui and lets realm admins
# (alice, group /mcp-admins) manage systems; carol (/mcp-support) can sign in but the API answers forbidden.
# Needs: docker compose up in examples/run-modes, etc/mkcert.sh once (the session cookie is Secure, so https only).
#   set -a; source examples/management-ui/env/ui.env; set +a
#   ./mvnw quarkus:dev -pl modules/backend -am          # UI: https://localhost:8443/ui/
KC_MCP_URL=http://localhost:8080
KC_MCP_AUTH_REALM=demo
KC_MCP_CLIENT_ID=mcp-admin
KC_MCP_CLIENT_SECRET=mcp-admin-secret
KC_MCP_DEFAULT_REALM=demo
KC_MCP_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
# sessions, systems, keys in an embedded H2 file database (data/ is git-ignored)
QUARKUS_DATASOURCE_JDBC_URL=jdbc:h2:file:./data/kc-mcp-ui
KC_MCP_STORAGE_SECRET_KEY=demo-storage-key-change-me
KC_MCP_DYNAMIC_SYSTEMS=true
# the UI, its identity provider and the role that opens the API (the demo realm has no master admins)
KC_MCP_UI_ENABLED=true
KC_MCP_UI_ISSUER=http://localhost:8080/realms/demo
KC_MCP_UI_CLIENT_ID=keycloak-mcp-ui
KC_MCP_ADMIN_ROLE=realm-management.realm-admin
# the admin API over bearer tokens as well, for curl next to the UI
KC_MCP_ADMIN_ENABLED=true
KC_MCP_ADMIN_ISSUER=http://localhost:8080/realms/demo
KC_MCP_ADMIN_AUDIENCE=mcp-admin
# https with the mkcert certificate (etc/mkcert.sh)
QUARKUS_TLS_KEY_STORE_PEM_UI_CERT=.certs/localhost.pem
QUARKUS_TLS_KEY_STORE_PEM_UI_KEY=.certs/localhost-key.pem
