# As ui.env, with two identity providers: the demo realm and the master realm of the same Keycloak. The UI shows one
# sign-in button per provider; a master admin (admin/admin) also gets the API, through the realm role admin.
#   set -a; source examples/management-ui/env/ui-two-idps.env; set +a
#   ./mvnw quarkus:dev -pl modules/backend -am
# Register the client in master first (once, Keycloak must be up):
#   examples/management-ui/master-client.sh
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8080
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=mcp-admin
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=mcp-admin-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
QUARKUS_DATASOURCE_JDBC_URL=jdbc:h2:file:./data/kc-mcp-ui
KC_MCP_STORAGE_SECRET_KEY=demo-storage-key-change-me
KC_MCP_DYNAMIC_SYSTEMS=true
KC_MCP_UI_ENABLED=true
KC_MCP_UI_IDPS_DEMO_ISSUER=http://localhost:8080/realms/demo
KC_MCP_UI_IDPS_DEMO_CLIENT_ID=keycloak-mcp-ui
KC_MCP_UI_IDPS_DEMO_DISPLAY_NAME=Demo realm (alice, carol)
KC_MCP_UI_IDPS_MASTER_ISSUER=http://localhost:8080/realms/master
KC_MCP_UI_IDPS_MASTER_CLIENT_ID=keycloak-mcp-ui
KC_MCP_UI_IDPS_MASTER_DISPLAY_NAME=Keycloak master (admin)
# realm admins of demo hold realm-management.realm-admin, master admins the realm role admin: one role gate for both
# is not possible yet, so this run uses the demo role; master admins see the API answer forbidden (see README)
KC_MCP_ADMIN_ROLE=realm-management.realm-admin
QUARKUS_TLS_KEY_STORE_PEM_UI_CERT=.certs/localhost.pem
QUARKUS_TLS_KEY_STORE_PEM_UI_KEY=.certs/localhost-key.pem
