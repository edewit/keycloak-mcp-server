# Delegated agent plus the server-side policy layer (scenario "support user with extra checks"): the same delegation
# as delegation.env, and on top of what Keycloak enforces through the delegated token
#   - keycloak_user_delete is not offered at all (KC_MCP_DENIED_TOOLS)
#   - group membership changes stay within the caller's own groups and need the realm role group-manager
#     (alice has it, carol does not)
#   - no privilege escalation: nobody grants roles they do not hold themselves, nobody touches users who outrank them
# The policies provider looks groups and roles up with the delegated token, so no server credentials beyond the
# actor's are needed.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8096
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=exchange
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=keycloak-mcp
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=keycloak-mcp-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
# the actor's service account may not read the server info, so the version is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
QUARKUS_HTTP_PORT=8097
QUARKUS_OIDC_TENANT_ENABLED=true
QUARKUS_OIDC_TOKEN_AUDIENCE=keycloak-mcp
QUARKUS_OIDC_RESOURCE_METADATA_SCOPES=openid,delegation:client:keycloak-mcp
KC_MCP_DENIED_TOOLS=keycloak_user_delete
KC_MCP_SPI_TOOLS_POLICIES_GROUP_SCOPE=group
KC_MCP_SPI_TOOLS_POLICIES_MANAGER_ROLE=realm:group-manager
KC_MCP_SPI_TOOLS_POLICIES_NO_ESCALATION=true
