# Delegated agent (Keycloak 26.8 token exchange delegation, preview): the MCP endpoint requires an OAuth login,
# the user consents to the client keycloak-mcp acting on their behalf (scope delegation:client:keycloak-mcp), and
# every Admin API call runs with a delegated token Keycloak issues for that pair: sub = the user, act = keycloak-mcp,
# roles = the user's realm-management roles within keycloak-mcp's role scope. The server's own service account
# holds no admin role at all.
#   alice  /mcp-admins  -> realm-admin, capped by the actor's scope to users/events (no clients, no realm settings)
#   carol  /mcp-support -> view-users, view-events  (reads work, writes come back as forbidden)
#   bob    no realm-management roles                (every tool call is forbidden)
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8096
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=exchange
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=keycloak-mcp
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=keycloak-mcp-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
# the actor's service account may not read the server info, so the version is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
QUARKUS_HTTP_PORT=8097
# Bearer tokens of realm demo are verified; issuer = KC_MCP_SYSTEMS_DEFAULT_URL/realms/KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM.
QUARKUS_OIDC_TENANT_ENABLED=true
# Only tokens issued for this server: the delegation scope adds aud=keycloak-mcp, and so does the client scope
# keycloak-mcp-audience (default on mcp-consumer) for logins without it, which then get a delegation_failed answer.
QUARKUS_OIDC_TOKEN_AUDIENCE=keycloak-mcp
# What the protected resource metadata tells MCP clients to ask for (RFC 9728 scopes_supported).
QUARKUS_OIDC_RESOURCE_METADATA_SCOPES=openid,delegation:client:keycloak-mcp
