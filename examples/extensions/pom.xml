<?xml version="1.0" encoding="UTF-8"?>
<!-- A keycloak-mcp-server extension jar: compiles against the api module only, lands in the server's providers/ directory.
     Part of this repository's build (the parent supplies plugin and dependency versions); as a project of your own, replace
     the parent with explicit versions of the three dependencies and the auto-service annotation processor. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.thomasdarimont.keycloak</groupId>
        <artifactId>keycloak-mcp-server</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <groupId>com.acme</groupId>
    <artifactId>acme-keycloak-mcp-extensions</artifactId>
    <name>ACME extensions for keycloak-mcp-server</name>
    <description>Example extensions: tools, prompt, confirmer, access check, audit listener, scrubber, system repository.</description>

    <properties>
        <!-- surefire's @{argLine} is set by the Quarkus plugin in the backend; a plain jar module defines it empty -->
        <argLine/>
    </properties>

    <dependencies>
        <dependency>
            <!-- provided: the server has the api (and the Keycloak admin client, Vert.x JSON) on its class path -->
            <groupId>com.github.thomasdarimont.keycloak</groupId>
            <artifactId>keycloak-mcp-server-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- @AutoService writes META-INF/services at compile time; the server discovers the extensions through it -->
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
