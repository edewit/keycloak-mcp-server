<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-mcp-server-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>keycloak-mcp-server-api</artifactId>
    <name>Keycloak MCP Server API</name>
    <description>SPI and tool catalog types for extending the Keycloak MCP server: ToolProvider, AccessCheck,
        AuditListener, ToolSpec, ToolCall, the KeycloakAdmin facade. No Quarkus dependency.</description>

    <dependencies>
        <dependency>
            <!-- tool schemas and results are Vert.x JSON -->
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <!-- handlers work with the admin client's resources and representations; the JAX-RS client
                 implementation (RESTEasy Classic here, Quarkus REST in the server) is the application's choice -->
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <!-- McpServerConfig is a SmallRye @ConfigMapping; the server supplies the runtime -->
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config-core</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- a Jandex index lets Quarkus discover the @ConfigMapping and the SPI types in this jar -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
